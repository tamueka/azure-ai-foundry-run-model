# Plantilla de configuración local del CLI (spec 001).
# Copia este archivo a .env y rellena tus valores:
#   Copy-Item .env.example .env
#
# No contiene secretos: la autenticación usa Entra ID (az login).

AZURE_OPENAI_ENDPOINT="https://<tu-recurso>.services.ai.azure.com/openai/v1"
AZURE_OPENAI_DEPLOYMENT="<nombre-del-deployment>"

# Opcionales (los valores mostrados son los predeterminados)
# AZURE_OPENAI_SCOPE="https://ai.azure.com/.default"
# AZURE_OPENAI_TIMEOUT_MS="60000"
